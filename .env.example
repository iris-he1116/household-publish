# このファイルは .env のテンプレート。
# 実際に使う値は `.env` にコピーして書き込む（`.env` は git 管理外）。
#
#   cp .env.example .env
#   # 下のパスワードを好きな文字列に書き換える

POSTGRES_PASSWORD=change_me_in_dot_env

# Python 側から DB に接続するときの URL
# ホストから接続する場合（今の Phase 2 で使う）
DATABASE_URL=postgresql+psycopg://household_user:change_me_in_dot_env@localhost:5432/household

# 初期ユーザー2人のログインパスワード（seed マイグレーションで bcrypt ハッシュ化して投入）
# `openssl rand -base64 24` などで生成した値を入れる
ALICE_PASSWORD=change_me_in_dot_env
HITSUJI_PASSWORD=change_me_in_dot_env

# ログレベル（DEBUG / INFO / WARNING / ERROR）。未設定なら INFO
# LOG_LEVEL=INFO

# --- 認証（Phase 5）---
# JWT の署名鍵。32文字以上。次で生成:  openssl rand -base64 48
# 漏れるとトークンを偽造されるので絶対に共有しない。変更すると全員ログアウト。
JWT_SECRET=

# 何日間アプリを開かなかったら再ログインが必要か（既定 30）
JWT_EXPIRE_DAYS=30

# HTTPS でのみ Cookie を送るか。tailscale serve（https）なら true。
# 素の http:// で繋ぐ場合は false にしないとログインできない。
COOKIE_SECURE=true
