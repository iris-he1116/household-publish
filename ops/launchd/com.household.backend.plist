<?xml version="1.0" encoding="UTF-8"?>
<!--
  家計清算アプリの backend を、Mac にログインしたら自動で起動する設定。

  置き場所: ~/Library/LaunchAgents/com.household.backend.plist
  （システム全体ではなく「このユーザーのログイン時」に動く。sudo は不要）

  KeepAlive=true にしているので、落ちても launchd が起動し直す。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.household.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sibei.he/alice_work/ops/start-backend.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sibei.he/alice_work</string>

    <!-- ログイン時に起動 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 落ちたら起動し直す -->
    <key>KeepAlive</key>
    <true/>

    <!-- 再起動が暴走しないよう最低10秒あける -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/sibei.he/alice_work/ops/logs/backend.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sibei.he/alice_work/ops/logs/backend.error.log</string>
</dict>
</plist>
